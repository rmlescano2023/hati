# Copy with `vercel env pull .env.local` rather than filling this in by hand —
# these values live in the Vercel project, not in the repo.

# Clerk. The publishable key is public by design and ships in the client bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Server-side only. Never expose this to the browser or commit it.
CLERK_SECRET_KEY=sk_test_...

# Postgres. Vercel created these with a POSTGRES prefix, so the pooled URL is
# named POSTGRES_DATABASE_URL rather than the client's default POSTGRES_URL.
POSTGRES_DATABASE_URL=postgres://...
